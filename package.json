{
  "name": "site-carros",
  "private": true,
  "description": "Plataforma de sites estáticos de revendas de carros",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:rapido": "SEM_NAVEGADOR=1 node --test tests/*.test.js",
    "test:snapshot": "SNAPSHOT_ATUALIZAR=1 node --test tests/snapshot-html.test.js",
    "test:cobertura": "SEM_NAVEGADOR=1 node --test --experimental-test-coverage tests/*.test.js",
    "build": "node core/build.js",
    "testar": "node core/cli.js testar",
    "status": "node core/cli.js status",
    "cli": "node core/cli.js",
    "servidor": "node api/servidor.js",
    "exemplo": "node ferramentas/gerar-exemplo.js",
    "api": "node api/servidor.js",
    "cliente": "node api/cli.js cliente"
  },
  "engines": {
    "node": ">=20"
  }
}
